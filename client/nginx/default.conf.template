# Rendered by the nginx image: ${API_UPSTREAM} comes from the environment, other $vars are nginx's own.
# The API pool. `resolve` re-reads Docker's DNS every 10 seconds, so `--scale api=N` is picked up
# without a restart and requests are spread over every replica. `keepalive` reuses connections;
# without it nginx opens a new TCP connection per request and runs out of ports under load.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_pool {
  zone api_pool 64k;
  server ${API_UPSTREAM} resolve;
  keepalive 128;
  keepalive_requests 10000;
  keepalive_timeout 60s;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  client_max_body_size 1m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  location /api/ {
    proxy_pass http://api_pool;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Behind a TLS-terminating load balancer, keep its scheme; otherwise use ours.
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }

  # Metrics are for the internal network only; never reachable through the public port.
  location = /metrics {
    return 404;
  }

  # Hashed build output never changes, so cache it for a year.
  location /assets/ {
    try_files $uri =404;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # The shell and service worker must always be revalidated so deploys take effect.
  location ~ ^/(sw\.js|workbox-.*\.js|registerSW\.js|manifest\.webmanifest|index\.html)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }
}
