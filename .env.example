# Express API port
PORT=4000

# Comma-separated browser origins allowed by the API
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# PostgreSQL connection (matches docker-compose.yml: `npm run db:up`)
DATABASE_URL=postgres://stillnote:stillnote@localhost:5432/stillnote

# Max connections in the API's pool
PG_POOL_MAX=20

# Redis keeps rate limits shared across API processes (optional; leave empty for in-memory)
REDIS_URL=redis://localhost:6379

# Set to true when running behind nginx or a load balancer
TRUST_PROXY=false

# Session cookie `Secure` flag (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=true
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=true

# Requests per window per signed-in user (or IP); sign-in/register attempts per minute per IP
RATE_LIMIT_MAX=1200
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# Log level (debug, info, warn, error) and cluster size (0 = one worker per CPU)
LOG_LEVEL=info
WEB_CONCURRENCY=0
