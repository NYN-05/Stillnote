{
  "name": "stillnote-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A minimalist, distraction-free Markdown text editor with local and server persistence.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev --workspace @stillnote/server\" \"npm run dev --workspace @stillnote/client\"",
    "dev:server": "npm run dev --workspace @stillnote/server",
    "dev:client": "npm run dev --workspace @stillnote/client",
    "build": "npm run build --workspace @stillnote/client",
    "test": "npm run test --workspace @stillnote/server",
    "start": "npm run start --workspace @stillnote/server",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @stillnote/server",
    "db:import": "npm run import:json --workspace @stillnote/server",
    "start:cluster": "npm run start:cluster --workspace @stillnote/server",
    "db:claim": "npm run claim:legacy --workspace @stillnote/server --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace @stillnote/client",
    "test:client": "npm run test --workspace @stillnote/client",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky || true",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "loadtest:seed": "bash loadtest/seed.sh",
    "loadtest": "node loadtest/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml,md}": "prettier --write"
  }
}
