{
  "name": "@stillnote/server",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify API and PostgreSQL persistence for Stillnote.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "migrate": "node -e \"require('dotenv').config({path:'../.env'});const d=require('./src/db');const p=d.createPool();d.migrate(p).then(a=>console.log('Applied:',a.join(', ')||'none')).finally(()=>p.end())\"",
    "convert-content": "node scripts/convert-content.js",
    "import:json": "node scripts/import-json.js",
    "start:cluster": "node cluster.js",
    "claim:legacy": "node scripts/claim-legacy.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@sentry/node": "^11.9.0",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "markdown-it": "^15.0.3",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
