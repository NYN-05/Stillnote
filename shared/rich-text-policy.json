{
  "schemaVersion": 1,
  "maxContentLength": 500000,
  "maxTitleLength": 120,
  "defaultNoteTitle": "Untitled note",
  "allowedTags": [
    "p",
    "br",
    "strong",
    "em",
    "u",
    "s",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "ul",
    "ol",
    "li",
    "blockquote",
    "pre",
    "code",
    "a",
    "hr",
    "table",
    "colgroup",
    "col",
    "thead",
    "tbody",
    "tr",
    "th",
    "td",
    "img"
  ],
  "allowedAttributes": {
    "a": ["href", "title", "target", "rel"],
    "img": ["src", "alt", "title"],
    "th": ["colspan", "rowspan"],
    "td": ["colspan", "rowspan"],
    "p": ["style"],
    "h1": ["style"],
    "h2": ["style"],
    "h3": ["style"],
    "h4": ["style"],
    "h5": ["style"],
    "h6": ["style"],
    "table": ["style"],
    "col": ["style"]
  },
  "allowedStyles": {
    "p": { "text-align": ["left", "center", "right", "justify"] },
    "h1": { "text-align": ["left", "center", "right", "justify"] },
    "h2": { "text-align": ["left", "center", "right", "justify"] },
    "h3": { "text-align": ["left", "center", "right", "justify"] },
    "h4": { "text-align": ["left", "center", "right", "justify"] },
    "h5": { "text-align": ["left", "center", "right", "justify"] },
    "h6": { "text-align": ["left", "center", "right", "justify"] },
    "table": { "width": ["px"], "min-width": ["px"] },
    "col": { "width": ["px"], "min-width": ["px"] }
  },
  "linkSchemes": ["http", "https", "mailto"],
  "imageSchemes": ["http", "https"],
  "linkRel": "noopener noreferrer nofollow",
  "linkTarget": "_blank"
}
