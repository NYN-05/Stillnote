# Copy to .env.production (git-ignored) and fill in. Used by docker-compose.prod.yml.

# Required
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The exact origin users type in the browser, with scheme and no trailing slash.
PUBLIC_ORIGIN=http://localhost:8080

# Where the web container listens on the host
WEB_PORT=8080

# Session cookies are sent only over HTTPS when true (keep true behind a TLS proxy).
# localhost is exempt, so true also works for a local trial.
COOKIE_SECURE=true
# Set to false after you have created your accounts
ALLOW_REGISTRATION=true

# Optional
# METRICS_TOKEN=            # bearer token for GET /metrics on the api container (internal network only)
# SENTRY_DSN=               # enables error reporting when set
# PG_POOL_MAX=20
# RATE_LIMIT_MAX=1200
# LOG_LEVEL=info
# STILLNOTE_API_IMAGE=ghcr.io/your-org/stillnote-api:latest   # use prebuilt images instead of building
# STILLNOTE_WEB_IMAGE=ghcr.io/your-org/stillnote-web:latest
